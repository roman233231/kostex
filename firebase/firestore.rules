rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Допоміжна функція: чи є користувач автентифікованим
    function isSignedIn() {
      return request.auth != null;
    }

    // Чи є користувач адміністратором
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Чи належить ресурс користувачу
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Колекція users
    match /users/{userId} {
      // Читати може сам користувач або адмін
      allow read: if isOwner(userId) || isAdmin();
      // Створювати можна лише власний документ (при реєстрації)
      allow create: if isOwner(userId);
      // Оновлювати може сам користувач (але не змінювати роль) або адмін
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      // Видаляти може лише адмін
      allow delete: if isAdmin();
    }

    // Колекція orders
    match /orders/{orderId} {
      // Клієнт читає свої замовлення, адмін — всі
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Створювати може автентифікований користувач, поле userId має відповідати йому
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Оновлювати може адмін, або власник у дозволених статусах (наприклад, поки статус NEW)
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'NEW');
      // Видаляти може лише адмін
      allow delete: if isAdmin();
    }

    // Колекція products (каталог) — публічне читання, запис лише адмін
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Колекція categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Колекція features
    match /features/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Колекція portfolio
    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Колекція messages — пов'язані з замовленням
    match /messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Колекція files
    match /files/{fileId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Інші колекції за замовчуванням — закрити
    match /{document=**} {
      allow read, write: if false;
    }
  }
}